<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The light theme follows the Windows system colors. -->
  <SolidColorBrush x:Key="Theme.Background" Color="{x:Static SystemColors.ControlColor}" />
  <SolidColorBrush x:Key="Theme.Foreground" Color="{x:Static SystemColors.ControlTextColor}" />
  <SolidColorBrush x:Key="Theme.ContentBackground" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Theme.ContentForeground" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Theme.Border" Color="{x:Static SystemColors.ActiveBorderColor}" />
  <SolidColorBrush x:Key="Theme.SecondaryForeground" Color="{x:Static SystemColors.GrayTextColor}" />
  <SolidColorBrush x:Key="Theme.Error" Color="#C42B1C" />

</ResourceDictionary>
