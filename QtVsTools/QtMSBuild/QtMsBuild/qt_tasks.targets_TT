///////////////////////////////////////////////////////////////////////////////////////////////////
// Helper inline tasks used by the Qt/MSBuild targets
// -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- BEGIN Generated code <#=XML_COMMENT_END#><#

    // Parse .cs files and generate inline MSBuild tasks using C# code
    //
    var files = Directory.GetFiles(Path.Combine(SolutionDir, "QtMsBuild", "Tasks"), "*.cs");
    foreach(var file in files) {
        var text = File.ReadAllText(file);
        var task = ParseTask(text);
        var commentLines = task.Comment
            .TrimEnd('\r', '\n').Split(new[] {"\r\n"}, StringSplitOptions.None);
        var taskAttribs = task.Attributes;
        var namespaces = task.Namespaces;
        var parameters = task.Parameters
            .Where((ParamDecl p) => !string.IsNullOrEmpty(p.name))
            .OrderBy((ParamDecl p) => p.isOut)
            .ThenBy((ParamDecl p) => p.isOptional);
        var taskCode = task.Code.TrimEnd('\r', '\n');
        var assemblyRefs = task.References;

        WriteLine(string.Format(
////////////////////////////////////////////////////////////////////////////////////////////////////
@"
  {0}
  {1}
  {2}
  <UsingTask {3}
    TaskFactory=""CodeTaskFactory""
    AssemblyFile=""$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll"">
    <ParameterGroup>{4}
    </ParameterGroup>
    <Task>{5}{6}
      <Code Type=""Fragment"" Language=""cs"">
        <![CDATA[
{7}
        ]]>
      </Code>
    </Task>
  </UsingTask>",
////////////////////////////////////////////////////////////////////////////////////////////////////
        /*{0}*/ XML_COMMENT_BEGIN,
        /*{1}*/ string.Join("\r\n  ", commentLines),
        /*{2}*/ XML_COMMENT_END,
        /*{3}*/ taskAttribs,
        /*{4}*/ string.Join("", parameters.Select(param => string.Format(
@"
      <{0} ParameterType=""{1}""{2}{3}/>",
            /*{0}*/ param.name,
            /*{1}*/ param.type,
            /*{2}*/ param.isOut ? @" Output=""true""" : "",
            /*{3}*/ !param.isOut && !param.isOptional ? @" Required=""true""" : ""))),
        /*{5}*/ string.Join("", assemblyRefs.Select(assemblyRef => string.Format(
@"
      <Reference Include=""{0}""/>",
            /*{0}*/ assemblyRef))),
        /*{6}*/ string.Join("", namespaces.Select(nameSpc => string.Format(
@"
      <Using Namespace=""{0}""/>",
            /*{0}*/ nameSpc))),
        /*{7}*/ taskCode));
    }
  #>
  <#=XML_COMMENT_BEGIN#> END Generated code -->

</Project>
<!--<#=XML_COMMENT_END#>
<#@import namespace="System.Text.RegularExpressions" #>
<#+
    class ParamDecl {
        public string name;
        public string type;
        public bool isOptional;
        public bool isOut;
    }

    class TaskDecl {
        public string Attributes = "";
        public List<string> References = new List<string>();
        public List<string> Namespaces = new List<string>();
        public string Comment = "";
        public List<ParamDecl> Parameters = new List<ParamDecl>();
        public string Code = "";
    }

    static readonly Regex TaskRegex = new Regex(
        @"^[ \t]*\#region[ \t]+Task[ \t]*(?<attribs>[^\r\n]*)", RegexOptions.Multiline);

    // Text between a '#region <name>' line and the next '#endregion' line, including the
    // indentation and line break of each enclosed line.
    static readonly Regex RegionRegex = new Regex(
        @"^[ \t]*\#region[ \t]+(?<name>Reference|Using|Comment|Parameters|Code)\b[^\n]*\n"
        + @"(?<body>.*?)^[ \t]*\#endregion",
        RegexOptions.Multiline | RegexOptions.Singleline);

    static readonly Regex ReferenceRegex = new Regex(
        @"^[ \t]*//(?<ref>[^\r\n]*)", RegexOptions.Multiline);

    static readonly Regex UsingRegex = new Regex(
        @"\busing\s+(?<nameSpc>(?:static\s+)?[\w.]+)\s*;");

    static readonly Regex ParamRegex = new Regex(
        @"(?<out>\bout\s+)?(?<type>[\w.]+(?:\s*\[\s*\])?)\s+(?<name>\w+)"
        + @"\s*(?<optional>=\s*(?:null|0|false))?\s*[,)]");

    TaskDecl ParseTask(string text)
    {
        var task = new TaskDecl();
        var taskMatch = TaskRegex.Match(text);
        if (!taskMatch.Success)
            return task;
        task.Attributes = taskMatch.Groups["attribs"].Value.Trim();

        foreach (Match region in RegionRegex.Matches(text, taskMatch.Index + taskMatch.Length)) {
            var body = region.Groups["body"].Value;
            switch (region.Groups["name"].Value) {
            case "Reference":
                task.References = ReferenceRegex.Matches(body).Cast<Match>()
                    .Select(x => x.Groups["ref"].Value.Trim())
                    .ToList();
                break;
            case "Using":
                task.Namespaces = UsingRegex.Matches(body).Cast<Match>()
                    .Select(x => x.Groups["nameSpc"].Value)
                    .ToList();
                break;
            case "Comment":
                task.Comment = body;
                break;
            case "Parameters":
                task.Parameters = ParamRegex.Matches(body).Cast<Match>()
                    .Select(x => new ParamDecl
                    {
                        name = x.Groups["name"].Value,
                        type = x.Groups["type"].Value,
                        isOut = x.Groups["out"].Success,
                        isOptional = x.Groups["optional"].Success
                    })
                    .ToList();
                break;
            case "Code":
                task.Code = body;
                break;
            }
        }
        return task;
    }
//-->#>
