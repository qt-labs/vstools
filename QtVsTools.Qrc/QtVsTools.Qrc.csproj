<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <LangVersion>9.0</LangVersion>

    <RootNamespace>QtVsTools.Qrc</RootNamespace>
    <AssemblyName>QtVsTools.Qrc</AssemblyName>

    <!-- We have an AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- We want to be explicit about the included files -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Observable.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="QrcCommands.cs" />
    <Compile Include="QrcDocument.cs" />
    <Compile Include="QrcException.cs" />
    <Compile Include="QrcFile.cs" />
    <Compile Include="QrcPath.cs" />
    <Compile Include="QrcPrefix.cs" />
    <Compile Include="UndoStack.cs" />
  </ItemGroup>

  <!-- Provides the text templating targets that 'vstools -init' runs for every project -->
  <Import Project="$(SolutionDir)\transform.targets" Condition="Exists('$(SolutionDir)\transform.targets')" />

</Project>
